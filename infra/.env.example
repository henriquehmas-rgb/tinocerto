MINIO_RESUME_BUCKET=curriculos
ENVELOPE_ENCRYPTION_KEK=GERAR_COM:_openssl_rand_-base64_32 # nunca reutilize entre ambientes -- gere um valor novo pra cada ambiente (dev local, CI, producao)
CPF_HASH_PEPPER=GERAR_COM:_openssl_rand_-hex_32 # nunca reutilize entre ambientes -- gere um valor novo pra cada ambiente e nunca troque depois de haver cpf_hash gravado (invalida todos os hashes existentes)
API_KEY_HASH_PEPPER=GERAR_COM:_openssl_rand_-hex_32 # nunca reutilize entre ambientes -- gere um valor novo pra cada ambiente e nunca troque depois de haver api_key hasheada (invalida todas as chaves existentes)
WEBHOOK_SECRET_ENCRYPTION_KEY=GERAR_COM:_openssl_rand_-base64_32 # nunca reutilize entre ambientes -- gere um valor novo pra cada ambiente (dev local, CI, producao)
CANDIDATE_JWT_SECRET=GERAR_COM:_openssl_rand_-base64_48 # nunca reutilize entre ambientes -- gere um valor novo pra cada ambiente (dev local, CI, producao)
STAFF_JWT_SECRET=GERAR_COM:_openssl_rand_-base64_48 # nunca reutilize entre ambientes -- gere um valor novo pra cada ambiente (dev local, CI, producao)
